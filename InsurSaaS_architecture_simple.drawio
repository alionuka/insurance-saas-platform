<mxfile host="app.diagrams.net" agent="claude" version="22.0.0">
  <diagram name="Архітектура (мінімум)" id="insursaas-arch-mini">
    <mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Архітектура системи" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="225" y="15" width="400" height="35" as="geometry" />
        </mxCell>

        <!-- User actor -->
        <mxCell id="user" value="Користувач" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="50" height="70" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="frontend" value="Frontend&#xa;Next.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="205" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Backend -->
        <mxCell id="backend" value="Backend&#xa;NestJS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="205" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- ML Service -->
        <mxCell id="ml" value="ML Service&#xa;FastAPI + SHAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="db" value="PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="585" y="300" width="110" height="80" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" value="HTTPS" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="REST + JWT" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="frontend" target="backend">
