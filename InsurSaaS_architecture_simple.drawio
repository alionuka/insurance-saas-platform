        <mxCell id="a3" value="HTTP + API-Key" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="backend" target="ml">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="SQL (Prisma)" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="backend" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
