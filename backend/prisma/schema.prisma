generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum UserRole {
  CUSTOMER
  AGENT
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum ProductType {
  LIFE
  AUTO
  HEALTH
  PROPERTY
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum ClaimStatus {
  FILED
  IN_PROGRESS
  APPROVED
  DENIED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FraudFlag {
  NORMAL
  SUSPICIOUS
}

enum PolicyStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// --- Models ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  role         UserRole @default(CUSTOMER)
  firstName    String
  lastName     String
  age          Int?
  annualIncome Float?
  creditScore  Int?
  passwordHash String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  applications        Application[]
  claims              Claim[]
  policies            Policy[]
  recommendations     Recommendation[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  uploadedDocuments   ClaimDocument[]    @relation("UploadedDocuments")
  payments            Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique // TODO: hash before storing in v2
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Company {
  id          String  @id @default(uuid())
  name        String
  description String?

  // KYC fields captured at self-service onboarding. Stored but not validated
  // by an external compliance provider in this thesis scope — production
  // would wire these into ComplyAdvantage / Onfido / similar before
  // transitioning the tenant from PENDING_VERIFICATION to ACTIVE.
  licenseNumber String?
  country       String?
  contactPhone  String?

  status     CompanyStatus @default(ACTIVE)
  approvedAt DateTime?
  approvedBy String? // PLATFORM_ADMIN user id who flipped the switch

  // Tenant branding — visible to end-customers on product cards, application
  // details, payment receipts. logoUrl points to an R2 (or local fs) URL
  // uploaded via POST /companies/me/logo. primaryColor is a hex string used
  // by the frontend to tint CTAs and headers.
  logoUrl      String?
  primaryColor String? // hex (#6366f1) — validated by the frontend before submit

  users    User[]
  products InsuranceProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model InsuranceProduct {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  name        String
  type        ProductType
  description String?
  basePremium Float       @default(0)

  applications Application[]
  policies     Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  productId String
  product   InsuranceProduct  @relation(fields: [productId], references: [id])
  status    ApplicationStatus @default(PENDING)

  claims          Claim[]
  policy          Policy?
  riskAssessments RiskAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Claim {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  policyId      String?
  policy        Policy?     @relation(fields: [policyId], references: [id])
  amount        Float
  description   String
  status        ClaimStatus @default(FILED)

  fraudAssessments FraudAssessment[]
  documents        ClaimDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClaimDocument {
  id           String   @id @default(uuid())
  claimId      String
  claim        Claim    @relation(fields: [claimId], references: [id])
  filename     String
  url          String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], name: "UploadedDocuments")
  uploadedAt   DateTime @default(now())
}

model RiskAssessment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  riskScore     Float
  riskLevel     RiskLevel
  explanation   String
  featureContributions Json?

  createdAt DateTime @default(now())
}

model FraudAssessment {
  id                   String            @id @default(uuid())
  claimId              String
  claim                Claim             @relation(fields: [claimId], references: [id])
  fraudScore           Float
  flag                 FraudFlag
  explanation          String
  featureContributions Json?

  createdAt DateTime @default(now())
}

model Recommendation {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  recommendedProducts String[] // Simplified: storing product names or IDs as an array of strings
  explanation         String

  createdAt DateTime @default(now())
}

model Policy {
  id            String           @id @default(uuid())
  policyNumber  String           @unique
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  productId     String
  product       InsuranceProduct @relation(fields: [productId], references: [id])
  applicationId String           @unique
  application   Application      @relation(fields: [applicationId], references: [id])
  status        PolicyStatus     @default(ACTIVE)
  startDate     DateTime
  endDate       DateTime
  premiumAmount Float            @default(0)

  claims   Claim[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              String        @id @default(uuid())
  policyId        String
  policy          Policy        @relation(fields: [policyId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Float
  currency        String        @default("usd")
  stripeSessionId String?       @unique
  stripePaymentId String?       @unique
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorEmail   String?
  actorRole    UserRole?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([resourceType, resourceId])
}
