generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum UserRole {
  CUSTOMER
  AGENT
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum ProductType {
  LIFE
  AUTO
  HEALTH
  PROPERTY
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum ClaimStatus {
  FILED
  IN_PROGRESS
  APPROVED
  DENIED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FraudFlag {
  NORMAL
  SUSPICIOUS
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// --- Models ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  role         UserRole @default(CUSTOMER)
  firstName    String
  lastName     String
  age          Int?
  annualIncome Float?
  creditScore  Int?
  passwordHash String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  applications        Application[]
  claims              Claim[]
  policies            Policy[]
  recommendations     Recommendation[]
  passwordResetTokens PasswordResetToken[]
  uploadedDocuments   ClaimDocument[]    @relation("UploadedDocuments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique // TODO: hash before storing in v2
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Company {
  id          String  @id @default(uuid())
  name        String
  description String?

  users    User[]
  products InsuranceProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InsuranceProduct {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  name        String
  type        ProductType
  description String?
  basePremium Float       @default(0)

  applications Application[]
  policies     Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  productId String
  product   InsuranceProduct  @relation(fields: [productId], references: [id])
  status    ApplicationStatus @default(PENDING)

  claims          Claim[]
  policy          Policy?
  riskAssessments RiskAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Claim {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  policyId      String?
  policy        Policy?     @relation(fields: [policyId], references: [id])
  amount        Float
  description   String
  status        ClaimStatus @default(FILED)

  fraudAssessments FraudAssessment[]
  documents        ClaimDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClaimDocument {
  id           String   @id @default(uuid())
  claimId      String
  claim        Claim    @relation(fields: [claimId], references: [id])
  filename     String
  url          String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], name: "UploadedDocuments")
  uploadedAt   DateTime @default(now())
}

model RiskAssessment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  riskScore     Float
  riskLevel     RiskLevel
  explanation   String

  createdAt DateTime @default(now())
}

model FraudAssessment {
  id          String    @id @default(uuid())
  claimId     String
  claim       Claim     @relation(fields: [claimId], references: [id])
  fraudScore  Float
  flag        FraudFlag
  explanation String

  createdAt DateTime @default(now())
}

model Recommendation {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  recommendedProducts String[] // Simplified: storing product names or IDs as an array of strings
  explanation         String

  createdAt DateTime @default(now())
}

model Policy {
  id            String           @id @default(uuid())
  policyNumber  String           @unique
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  productId     String
  product       InsuranceProduct @relation(fields: [productId], references: [id])
  applicationId String           @unique
  application   Application      @relation(fields: [applicationId], references: [id])
  status        PolicyStatus     @default(ACTIVE)
  startDate     DateTime
  endDate       DateTime

  claims Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
