<mxfile host="app.diagrams.net" agent="claude" version="22.0.0">
  <diagram name="Діаграма класів (мінімум)" id="insursaas-class-mini">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Діаграма класів — бізнес-модель" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="225" y="15" width="500" height="35" as="geometry" />
        </mxCell>

        <!-- ──────────────── Company ──────────────── -->
        <mxCell id="company" value="Company" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="company_f" value="+ id : String (PK)&#xa;+ name : String&#xa;+ status : CompanyStatus&#xa;+ licenseNumber : String" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="company">
          <mxGeometry x="10" y="35" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ──────────────── User ──────────────── -->
        <mxCell id="user" value="User" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="180" height="135" as="geometry" />
        </mxCell>
        <mxCell id="user_f" value="+ id : String (PK)&#xa;+ email : String (unique)&#xa;+ role : UserRole&#xa;+ firstName / lastName&#xa;+ companyId : FK?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="user">
          <mxGeometry x="10" y="35" width="160" height="95" as="geometry" />
        </mxCell>

        <!-- ──────────────── InsuranceProduct ──────────────── -->
        <mxCell id="product" value="InsuranceProduct" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="660" y="240" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="product_f" value="+ id : String (PK)&#xa;+ companyId : FK&#xa;+ name : String&#xa;+ type : ProductType&#xa;+ basePremium : Float" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="product">
          <mxGeometry x="10" y="35" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ──────────────── Application ──────────────── -->
        <mxCell id="application" value="Application" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="application_f" value="+ id : String (PK)&#xa;+ userId : FK&#xa;+ productId : FK&#xa;+ status : ApplicationStatus" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="application">
          <mxGeometry x="10" y="35" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ──────────────── Policy ──────────────── -->
        <mxCell id="policy" value="Policy" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="380" y="420" width="180" height="135" as="geometry" />
        </mxCell>
        <mxCell id="policy_f" value="+ id : String (PK)&#xa;+ applicationId : FK (unique)&#xa;+ policyNumber : unique&#xa;+ status : PolicyStatus&#xa;+ premiumAmount : Float" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="policy">
          <mxGeometry x="10" y="35" width="160" height="95" as="geometry" />
        </mxCell>

        <!-- ──────────────── Claim ──────────────── -->
        <mxCell id="claim" value="Claim" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="claim_f" value="+ id : String (PK)&#xa;+ policyId : FK&#xa;+ amount : Float&#xa;+ status : ClaimStatus" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="claim">
          <mxGeometry x="10" y="35" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ──────────────── Payment ──────────────── -->
        <mxCell id="payment" value="Payment" style="shape=swimlane;fontSize=13;fontStyle=1;rounded=0;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="payment_f" value="+ id : String (PK)&#xa;+ policyId : FK&#xa;+ amount : Float&#xa;+ status : PaymentStatus" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="payment">
          <mxGeometry x="10" y="35" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ──────────────── Relations ──────────────── -->
        <!-- Company 1 -- 0..* User -->
        <mxCell id="r1" value="1   employs   0..*" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="company" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Company 1 -- 0..* InsuranceProduct -->
        <mxCell id="r2" value="1   offers   0..*" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="company" target="product">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User 1 -- 0..* Application -->
        <mxCell id="r3" value="1   submits   0..*" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="application">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- InsuranceProduct 1 -- 0..* Application -->
        <mxCell id="r4" value="1   referenced   0..*" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="product" target="application">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Application 1 -- 0..1 Policy -->
        <mxCell id="r5" value="1   becomes   0..1" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="application" target="policy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Policy 1 -- 0..* Claim -->
        <mxCell id="r6" value="1   claimed   0..*" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="policy" target="claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Policy 1 -- 0..* Payment -->
        <mxCell id="r7" value="1   invoiced   0..*" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="policy" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
